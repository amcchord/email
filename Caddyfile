email.mcchord.net {
    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), serial=(self)"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # API proxy to FastAPI
    # lb_try_duration holds requests through an API restart instead of returning
    # 502. Terminals sleep 5 minutes after a failed fetch, and their read timeout
    # is 20 seconds, so a held request must normally be answered sooner than that.
    handle /api/* {
        reverse_proxy localhost:8000 {
            flush_interval -1
            lb_try_duration 30s
        }
    }

    # E-ink terminal device endpoints (schedule.json + image.bmp)
    handle /terminal/* {
        reverse_proxy localhost:8000 {
            flush_interval -1
            lb_try_duration 30s
        }
    }

    # Web TUI - browser-based terminal interface
    handle_path /tui/* {
        reverse_proxy localhost:8022
    }
    handle /tui {
        redir /tui/ permanent
    }

    # Serve desktop app downloads
    handle_path /downloads/tui/* {
        root * /opt/mail/downloads/tui
        file_server browse
    }
    handle_path /downloads/* {
        root * /opt/mail/electron/build
        file_server browse
    }

    # Serve frontend static files
    handle {
        root * /opt/mail/frontend/dist
        try_files {path} /index.html
        file_server
    }

    # Logging
    # Secure terminal credentials are path-bound because the current firmware
    # cannot send an Authorization header. Never persist those request paths in
    # the access log. Application logs likewise avoid rendering request URLs.
    log_skip /terminal/device/*
    log {
        output file /var/log/caddy/mail.log
        format console
    }
}
